@{
    ViewData["Title"] = "Battleship";
}

<div class="container mt-4">
    <h1>Battleship</h1>

    <div class="mb-3">
        <button id="new-game" class="btn btn-primary">
            New Game
        </button>
    </div>

    <div id="game-status" class="mb-3">
        Click New Game to begin.
    </div>

    <div id="game-info" class="mb-3 d-none">
        <strong>Shots:</strong>
        <span id="shots-fired">0</span>

        <span class="mx-2">|</span>

        <strong>Ships Remaining:</strong>
        <span id="ships-remaining">0</span>
    </div>

    <div id="game-board"></div>

    <hr class="my-4" />

    <h2>Completed Games</h2>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Game</th>
                    <th>Board Size</th>
                    <th>Ships</th>
                    <th>Shots</th>
                    <th>Completed</th>
                </tr>
            </thead>
            <tbody id="game-summaries">
                <tr>
                    <td colspan="5">
                        No completed games.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/battleship.js"
            asp-append-version="true"></script>
}